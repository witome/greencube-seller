# 数据库（建议专用应用账号，仅增删改查；迁移/DDL 用 root）
DATABASE_URL="mysql://lvlifang_app:密码@localhost:3306/lvlifang"

# JWT（必填：生成方式 `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`）
JWT_SECRET=""
JWT_EXPIRES="7d"

# 服务端口
PORT=3000

# CORS（上线改成小程序/后台域名，逗号分隔）
CORS_ORIGIN="*"

# 微信小程序（阶段1 需要）
WX_APPID=""
WX_SECRET=""

# 申报截止时间（决策2：超时自动按可供量兜底）
DECLARE_DEADLINE_HOUR=22

# 平台服务费默认费率（对供应商应付抽成）
DEFAULT_SERVICE_FEE_RATE=0.05

# ── AI 下单解析（2026-09-23 新增）──
# 解析器选择：auto=配了 Key 就用大模型（失败自动降级规则版）/ rule=只用规则版 / llm=只试大模型（失败仍降级）
AI_PARSE_MODE=auto
# 阿里云百炼 API Key。留空 = 一律走规则版（不报错、不影响下单）
DASHSCOPE_API_KEY=""
# 百炼 OpenAI 兼容地址（华北2 北京；服务器同地域）
AI_PARSE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# 模型名（以百炼控制台「模型列表」为准）
AI_PARSE_MODEL="qwen-flash"
# 单次解析超时（毫秒），超时即降级规则版
AI_PARSE_TIMEOUT_MS=8000
# 是否要求模型只回 JSON（response_format）。若该模型不支持这个参数，改成 0
AI_PARSE_JSON_MODE=1
