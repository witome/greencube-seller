# 数据库（MySQL）
DATABASE_URL="mysql://root:密码@localhost:3306/lvlifang"

# JWT（⚠️ 上线必须换成随机长字符串）
JWT_SECRET="lvlifang-dev-secret-change-me"
JWT_EXPIRES="7d"

# 服务端口
PORT=3000

# CORS（上线改成小程序/后台域名，逗号分隔）
CORS_ORIGIN="*"

# 微信小程序（阶段1 需要）
WX_APPID=""
WX_SECRET=""

# 申报截止时间（决策2：超时自动按可供量兜底）
DECLARE_DEADLINE_HOUR=22

# 平台服务费默认费率（对供应商应付抽成）
DEFAULT_SERVICE_FEE_RATE=0.05
