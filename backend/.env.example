# 数据库（建议专用应用账号，仅增删改查；迁移/DDL 用 root）
DATABASE_URL="mysql://lvlifang_app:密码@localhost:3306/lvlifang"

# JWT（必填：生成方式 `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`）
JWT_SECRET=""
JWT_EXPIRES="7d"

# 服务端口
PORT=3000

# CORS（上线改成小程序/后台域名，逗号分隔）
CORS_ORIGIN="*"

# 微信小程序（阶段1 需要）
WX_APPID=""
WX_SECRET=""

# 申报截止时间（决策2：超时自动按可供量兜底）
DECLARE_DEADLINE_HOUR=22

# 平台服务费默认费率（对供应商应付抽成）
DEFAULT_SERVICE_FEE_RATE=0.05

# ── AI 下单解析（2026-09-23 新增）──
# 解析器选择：auto=配了 Key 就用大模型（失败自动降级规则版）/ rule=只用规则版 / llm=只试大模型（失败仍降级）
AI_PARSE_MODE=auto
# 阿里云百炼 API Key。留空 = 一律走规则版（不报错、不影响下单）
DASHSCOPE_API_KEY=""
# 百炼 OpenAI 兼容地址（华北2 北京；服务器同地域）
AI_PARSE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
# 模型名（以百炼控制台「模型列表」为准）
AI_PARSE_MODEL="qwen-flash"
# 单次解析超时（毫秒），超时即降级规则版
AI_PARSE_TIMEOUT_MS=8000
# 是否要求模型只回 JSON（response_format）。若该模型不支持这个参数，改成 0
AI_PARSE_JSON_MODE=1

# ── 采购需求 · 到货通知（2026-09-25 新增）──
# 到货通知订阅消息模板 id。**真实模板 = 「预约商品到货通知」（一次性订阅，type=2）**，
# 字段＝商品名称 / 商品单价 / 温馨提示。公众平台「小程序 → 功能 → 订阅消息」申请通过后填这里。
# ⚠️ 留空时：小程序「到货通知我」按钮隐藏、接口返回业务错「运营还没配置到货通知模板」。
#    **绝不写死、绝不猜测模板 id** —— 写死的 id 一旦换主体/过期，运营只会看到
#    微信那边「template_id 不合法」这种看不懂的报错。
WX_SUBSCRIBE_TMPL_DEMAND=""
# 模板字段映射 **覆盖**（JSON，一般**不用填**）：
#   代码会先调微信 `GET /wxaapi/newtmpl/gettemplate` 把真实字段名问出来
#   （字段名在模板 content 的 `{{xxx.DATA}}` 里，官方接口**不返回** kid 数组），
#   再按字段**中文名**自动映射：名称→{name}、单价/价格/金额→{price}、温馨提示/备注/说明→{note}。
#   只有自动探测的结果不对（或想临时改文案）时才填这一行，填了就**优先于自动探测**。
# 可用变量：{name} 菜名 · {price} 商品单价（取商品表真实单价，系统回填）· {note} 温馨提示
#   格式按字段类型自动处理：thing/phrase 截断、amount 补「¥」、number 纯数字、time/date 用微信格式。
WX_SUBSCRIBE_TMPL_DEMAND_FIELDS=''
# 微信服务端接口 base。**生产必须留空**（走 https://api.weixin.qq.com）；
# 只有本地自测「假微信服务」时才设成 http://127.0.0.1:xxxx
WX_API_BASE=""
# 订阅消息跳转的小程序版本：formal 正式版 / trial 体验版 / developer 开发版
WX_MINIPROGRAM_STATE=formal

# ── 真实微信支付 APIv3（卡R1 2026-09-29；生产必填，值只进服务器 .env，绝不入库/进文档）──
# 验签方式 = 微信支付公钥模式（不是平台证书模式；该商户号调 /v3/certificates 返回 RESOURCE_NOT_EXISTS）
WXPAY_MCHID=""
# APIv3 密钥（32 位；回调报文 AES-256-GCM 解密用；只有一个，不要另设 APIv2 密钥）
WXPAY_APIV3_KEY=""
# 微信支付公钥 ID（应答/回调头 Wechatpay-Serial 会是它）
WXPAY_PUBLIC_KEY_ID=""
# 商户 API 证书 / 私钥（backend/certs/，权限 600）
WXPAY_CERT_PATH=""
WXPAY_KEY_PATH=""
# 微信支付公钥（验签微信的回调与应答）
WXPAY_PUBLIC_KEY_PATH=""
# 商户证书序列号（请求头 serial_no）
WXPAY_CERT_SERIAL=""
# ↓ 两个可选项：默认值即生产地址；只有本地「假微信服务器」自测时才覆盖
# WXPAY_API_BASE="https://api.mch.weixin.qq.com"
# WXPAY_NOTIFY_URL="https://api.hsfresh.com/api/v1/payment/wechat/notify"

# ── 订单超时自动关单（卡R1 2026-09-29；可选项）──
# 待确认(10)订单超过 N 分钟未支付 → 自动取消(91) + 关闭待支付流水(2) + 审计
ORDER_PAY_TIMEOUT_MINUTES=30
# 扫描频率（6 段 cron），默认每 10 分钟
# ORDER_TIMEOUT_CRON="0 */10 * * * *"
