// 绿立方 · 数据库 Schema
// 依据：《开发配套-数据模型与接口草案.md》数据字典 + 第五节已确认决策
// 生成：prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════
// 1. 用户与身份
// ══════════════════════════════════════════

model User {
  id        BigInt   @id @default(autoincrement())
  wxOpenid  String   @unique @map("wx_openid") @db.VarChar(64)
  wxUnionid String?  @map("wx_unionid") @db.VarChar(64)
  name      String?  @db.VarChar(32)
  /// 手机号：注册时补齐，可为空（唯一约束下 NULL 互不冲突）
  phone     String?  @unique @db.VarChar(20)
  /// ⚠️ 同账号可多身份：["purchaser","supplier","courier","admin"]
  roles     Json
  /// 0 禁用 / 1 正常
  status    Int      @default(1) @db.TinyInt
  /// 后台「账号+密码」登录（2026-09-19 拍板 1A）：
  /// scrypt 哈希，格式 scrypt$<salt-hex>$<hash-hex>；NULL = 未设置密码（不可后台密码登录）
  passwordHash String? @map("password_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaser Purchaser?
  supplier  Supplier?
  courier   Courier?
  cartItems CartItem[]
  /// 子账号体系：业务员(business_agent) 归属某个运营主账号
  parentId  BigInt?   @map("parent_id")

  @@map("user")
}

model Purchaser {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  shopName  String   @map("shop_name") @db.VarChar(100)
  contact   String   @db.VarChar(32)
  phone     String   @db.VarChar(20)
  address   String   @db.VarChar(255)
  /// 常用收货时段 ["早 05-08","中 10-13"]
  deliveryWindows Json? @map("delivery_windows")
  /// 1 COD(默认) / 2 周结 / 3 月结（运营审核开通）
  payMode   Int      @default(1) @map("pay_mode") @db.TinyInt
  creditLimit Decimal @default(0) @map("credit_limit") @db.Decimal(12, 2)
  /// 营业执照、食品经营许可证等
  qualification Json?

  /// ⚠️ 账号状态（主计划 4.1）：1待审核 2正常 3已驳回(可申诉) 4终态驳回(60天冻结) 5运营停用
  accountStatus Int @default(1) @map("account_status") @db.TinyInt

  /// ⚠️ 唯一索引：同一营业执照仅可注册 1 次（连锁分店走授权说明）
  businessLicenseNo  String? @unique @map("business_license_no") @db.VarChar(64)
  businessLicenseImg String? @map("business_license_img") @db.VarChar(255)
  foodPermitImg      String? @map("food_permit_img") @db.VarChar(255)

  registeredAt   DateTime  @default(now()) @map("registered_at")
  verifiedBy     BigInt?   @map("verified_by")
  verifiedAt     DateTime? @map("verified_at")
  /// 30 天内申诉次数（封顶 1 次）
  appealCount30d Int       @default(0) @map("appeal_count_30d") @db.TinyInt
  rejectReasonCode Int?    @map("reject_reason_code") @db.TinyInt
  rejectReasonText String? @map("reject_reason_text") @db.Text

  user User @relation(fields: [userId], references: [id])
  verificationLogs VerificationLog[]
  appealRecords    AppealRecord[]
  orders           Order[]

  @@index([accountStatus])
  @@index([phone])
  @@map("purchaser")
}

/// 采购方线下核实记录（主计划 4.1）
model VerificationLog {
  id          BigInt   @id @default(autoincrement())
  purchaserId BigInt   @map("purchaser_id")
  /// 核实人（业务员/运营 user_id）
  operatorId  BigInt   @map("operator_id")
  /// 1电话 2上门 3视频（可多选，存 JSON 数组）
  method      Json
  /// 1 通过 / 2 驳回
  result      Int      @db.TinyInt
  /// 1执照不符 2电话无人接 3地址不实 4非餐饮 5重复申请 6资料不全 9其他
  reasonCode  Int?     @map("reason_code") @db.TinyInt
  reasonText  String?  @map("reason_text") @db.Text
  /// 实地照片等附件 URL 列表
  attachments Json?
  durationMin Int?     @map("duration_min")
  /// 核实人电子签名
  signature   String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  purchaser Purchaser @relation(fields: [purchaserId], references: [id])

  @@index([purchaserId])
  @@map("verification_log")
}

/// 申诉记录（决策 6 · 2026-09-19 大辉拍板：申诉内容与附件必须入库）
/// 一条申诉一行。原实现只把 account_status 改回待审核、把正文与附件直接丢掉，
/// 运营根本看不到申诉内容；此表为申诉的唯一权威留存。
model AppealRecord {
  id          BigInt   @id @default(autoincrement())
  /// 采购方档案 id（权限归属；与 verification_log 等既有表同口径）
  purchaserId BigInt   @map("purchaser_id")
  /// 提交申诉的账号 user_id（提出人；purchaser.userId 唯一，二者 1:1）
  userId      BigInt   @map("user_id")
  /// 申诉正文（DTO 限 500 字，此处 TEXT 兜底）
  text        String   @db.Text
  /// 附件 URL 数组（小程序端当前不传，为「拍照留证」卡预留）
  attachments Json?
  /// 提交时刻的驳回原因快照（取自 purchaser.reject_reason_code / reject_reason_text）
  reasonCode   Int?    @map("reason_code") @db.TinyInt
  rejectReason String? @map("reject_reason") @db.Text
  /// 0 待处理 / 1 已处理（运营申诉复核后置 1）
  status      Int      @default(0) @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")
  /// 处理留痕（运营/业务员 user_id + 处理时间）
  handledBy   BigInt?   @map("handled_by")
  handledAt   DateTime? @map("handled_at")

  purchaser Purchaser @relation(fields: [purchaserId], references: [id])

  @@index([purchaserId])
  @@index([status, createdAt])
  @@map("appeal_record")
}

model Supplier {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  stallName String   @map("stall_name") @db.VarChar(100)
  /// 档口地址
  address   String?  @map("address") @db.VarChar(255)
  /// 0 待审核 / 1 合作中 / 2 停合作
  status    Int      @default(0) @db.TinyInt
  /// 营业执照、检疫证等，⚠️ 含有效期字段，临期预警
  qualification Json?
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  links ProductSupplierLink[]
  settlements Settlement[]
  applications ProductApplication[]
  categories SupplierCategory[]

  @@map("supplier")
}

model Courier {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  /// 1 平台自营 / 2 外部申请（审核制）
  source    Int      @default(1) @db.TinyInt
  /// ⚠️ 黑名单按此防重复申请
  idCardNo  String?  @unique @map("id_card_no") @db.VarChar(32)
  /// ⚠️ 到期前 15 天预警、到期禁接单
  healthCertExpiry DateTime? @map("health_cert_expiry") @db.Date
  /// 常温 / 冷链（决定可接线路）
  vehicleType Int    @default(1) @map("vehicle_type") @db.TinyInt
  /// 是否自有车辆：0 无 / 1 有
  ownVehicle Int    @default(0) @map("own_vehicle") @db.TinyInt
  /// 是否有驾驶证：0 无 / 1 有
  hasDriverLicense Int @default(0) @map("has_driver_license") @db.TinyInt
  /// 驾驶证类型（C1/C2/B2/A1/A2/D 等）
  licenseType String? @map("license_type") @db.VarChar(20)
  /// 试跑期标记（申请制前 7 单）
  trialStatus Int    @default(0) @map("trial_status") @db.TinyInt
  /// 1 正常 / 2 停用 / 9 黑名单
  status    Int      @default(1) @db.TinyInt

  /// 上线状态：0 下线 / 1 上线（仅上线可接单）
  online     Int      @default(0) @map("online") @db.TinyInt
  /// 接单模式：0 手动 / 1 自动接单
  autoAccept Int      @default(0) @map("auto_accept") @db.TinyInt
  /// 派单优先级（越小越优先，运营可设）
  priority   Int      @default(100) @map("priority")
  /// 同时最大派单数量限制（运营可设）
  maxOrders  Int      @default(10) @map("max_orders")
  /// 配送中标记：0 空闲可接单 / 1 配送中（出发后无法接新单，配送完自动恢复 0）
  onRoute    Int      @default(0) @map("on_route") @db.TinyInt

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("courier")
}

// ══════════════════════════════════════════
// 2. 商品域
// ══════════════════════════════════════════

model Category {
  id       BigInt  @id @default(autoincrement())
  name     String  @db.VarChar(50)
  parentId BigInt? @map("parent_id")
  sort     Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  supplierCategories SupplierCategory[]

  @@map("category")
}

/// 供应商分类授权（供应商只能在自己被授权的分类发布商品）
model SupplierCategory {
  id         BigInt @id @default(autoincrement())
  supplierId BigInt @map("supplier_id")
  categoryId BigInt @map("category_id")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([supplierId, categoryId])
  @@map("supplier_category")
}

/// ⚠️ 版本生效制核心表
model Product {
  id          BigInt   @id @default(autoincrement())
  categoryId  BigInt   @map("category_id")
  name        String   @db.VarChar(100)
  cover       String?  @db.VarChar(255)
  images      Json?
  /// 1 称重 / 2 固定规格
  weighType   Int      @default(1) @map("weigh_type") @db.TinyInt
  unit        String   @default("斤") @db.VarChar(10)
  specText    String?  @map("spec_text") @db.VarChar(100)
  /// 称重说明（采购方可见）
  weighNote   String?  @map("weigh_note") @db.VarChar(255)

  /// ⚠️ 当前生效版本的销售价（运营维护，供应商不可见）
  salePrice   Decimal  @map("sale_price") @db.Decimal(10, 2)
  /// 加价比例（销售价 = 供货价 × (1+rate)）
  markupRate  Decimal  @default(0.30) @map("markup_rate") @db.Decimal(5, 4)
  /// 1 = 单品单独设过加价比例（配置重算/批量时跳过）；0 = 继承（供应商 > 分类 > 全局默认，见 MarkupConfig）
  /// 最终生效值始终存本表 markup_rate（计算路径、列表展示不改语义）；来源文案由 admin-pricing 的解析函数给出
  markupOverridden Int @default(0) @map("markup_overridden") @db.TinyInt

  /// 0 下架 / 1 在售 / 2 变更审核中
  status      Int      @default(1) @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id])
  links    ProductSupplierLink[]
  cartItems CartItem[]
  orderItems OrderItem[]
  applications ProductApplication[]

  @@index([categoryId, status])
  @@map("product")
}

/// 商品申请（新品提交 + 变更申请，审核制）
/// 决策：供应商提交/变更均需运营审核；原版本在售至新版本生效
model ProductApplication {
  id         BigInt    @id @default(autoincrement())
  /// 1 新品 / 2 变更
  type       Int       @db.TinyInt
  /// 变更时指向原商品；新品为 null
  productId  BigInt?   @map("product_id")
  supplierId BigInt    @map("supplier_id")
  /// 申请内容（新品：全字段；变更：新值）
  payload    Json
  /// 变更时的新旧对照 [{ field, fieldText, oldValue, newValue }]
  diffs      Json?
  /// 0 待审核 / 1 通过 / 2 驳回
  status     Int       @default(0) @db.TinyInt
  rejectReason String? @map("reject_reason")
  reviewedBy BigInt?   @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  product  Product? @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, status])
  @@index([productId])
  @@map("product_application")
}

/// 供应商↔商品关联（供货价 + 优先级）
model ProductSupplierLink {
  id         BigInt  @id @default(autoincrement())
  productId  BigInt  @map("product_id")
  supplierId BigInt  @map("supplier_id")
  /// ⚠️ 供货价（供应商可见，采购方绝不可见）
  supplyPrice Decimal @map("supply_price") @db.Decimal(10, 2)
  /// ⚠️ 日可供量：快速改此值免审核即时生效
  dailySupply Decimal @default(0) @map("daily_supply") @db.Decimal(10, 2)
  /// 供货优先级：1 主供 2 次供 3 备供（小数字优先）
  priority   Int     @default(9) @db.TinyInt
  /// 0 停供 / 1 正常
  status     Int     @default(1) @db.TinyInt

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@index([productId, priority])
  @@map("product_supplier_link")
}

/// 购物车（采购方加购，按供应商分组展示）
model CartItem {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  qty       Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@map("cart_item")
}

// ══════════════════════════════════════════
// 3. 订单域
// ══════════════════════════════════════════

model Order {
  id           BigInt   @id @default(autoincrement())
  purchaserId  BigInt   @map("purchaser_id")
  deliveryDate DateTime @map("delivery_date") @db.Date
  /// 1早 2中 3晚
  timeWindow   Int      @map("time_window") @db.TinyInt
  /// 见《开发配套①》订单状态机：10待确认 20已拆单 30备货中 40待配送 50配送中 60已送达 70已完成 90已结算 91已取消
  status       Int      @default(10) @db.TinyInt
  amountOrdered Decimal @default(0) @map("amount_ordered") @db.Decimal(12, 2)
  amountFinal   Decimal? @map("amount_final") @db.Decimal(12, 2)
  /// 运费（满额免运费/次日达免运费规则计算，0 表示免运费）
  deliveryFee   Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  remark      String?  @db.VarChar(255)
  /// 缺货偏好：auto_replace | partial | cancel_all
  shortagePolicy String @default("auto_replace") @map("shortage_policy") @db.VarChar(20)
  /// 支付方式：0 未选（待支付）/ 1 微信支付 / 2 货到付款（COD）
  payMethod  Int      @default(0) @map("pay_method") @db.TinyInt
  /// 是否加急：0 普通 / 1 加急（加急收取加急运费）
  urgent     Int      @default(0) @db.TinyInt
  /// 货到付款收款凭证：配送员上传的客户付款拍照 + 记录（photos/courierId/paidAt）
  payProof   Json?    @map("pay_proof")
  /// 采购方「我已付款」声明时间（2026-09-19 卡L）
  /// ⚠️ 这只是「客户称已付」，**不是核销**：是否真收到钱仍以 payProof 为准，二者必须分开显示。
  buyerPaidClaimAt DateTime? @map("buyer_paid_claim_at")
  /// 1 小程序自选 / 2 AI 客服代下单（阶段 2）
  source      Int      @default(1) @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaser Purchaser    @relation(fields: [purchaserId], references: [id])
  items     OrderItem[]
  payments  PaymentRecord[]

  @@index([purchaserId, status])
  @@index([deliveryDate])
  @@map("order")
}

/// ⚠️ 五数量分别保存、互不覆盖
model OrderItem {
  id         BigInt  @id @default(autoincrement())
  orderId    BigInt  @map("order_id")
  productId  BigInt  @map("product_id")
  /// 决策 1：核单时才写入（下单时不拆单）
  supplierId BigInt? @map("supplier_id")

  /// ① 订购数量
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(10, 2)
  /// ② 申报数量（供应商备货申报，少交需填 shortageReason）
  qtyDeclared Decimal? @map("qty_declared") @db.Decimal(10, 2)
  /// ③ 验收数量（运营称重）—— ⚠️ 对账基数
  qtyAccepted Decimal? @map("qty_accepted") @db.Decimal(10, 2)
  /// ④ 分拣数量
  qtySorted   Decimal? @map("qty_sorted") @db.Decimal(10, 2)
  /// ⑤ 餐馆接受数量（拒收填 rejectReason）
  qtyReceived Decimal? @map("qty_received") @db.Decimal(10, 2)

  /// ⚠️ 决策 2：申报超时自动按可供量兜底标记
  isAutoDeclared Int @default(0) @map("is_auto_declared") @db.TinyInt

  shortageReason String? @map("shortage_reason") @db.VarChar(255)
  rejectReason   String? @map("reject_reason") @db.VarChar(255)
  /// 商品备注（采购方下单时对该单品的备注，如"切块""要嫩"）
  remark        String? @map("remark") @db.VarChar(255)

  /// ⚠️ 成交时点价格快照，不随商品改价变动
  /// supplyPrice 在「核单拆单」时才确定（决策1），故下单时可为空
  supplyPrice Decimal? @map("supply_price") @db.Decimal(10, 2)
  salePrice   Decimal  @map("sale_price") @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([supplierId])
  @@map("order_item")
}

model DeliveryTask {
  id        BigInt   @id @default(autoincrement())
  courierId BigInt   @map("courier_id")
  routeNo   String   @map("route_no") @db.VarChar(40)
  /// 站点序列（订单、地址、顺序）
  stationList Json   @map("station_list")
  /// 待取货/取货中/派送中/已完成/异常
  status    Int      @default(0) @db.TinyInt
  /// 签收照片 + 电子签名 URL
  proof     Json?
  /// 交付完成时间（用于「今日已完成」筛选）
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([courierId, status])
  @@map("delivery_task")
}

/// 配送异常工单（配送员上报后生成，运营后台处理）
model DeliveryException {
  id             BigInt    @id @default(autoincrement())
  deliveryTaskId BigInt?   @map("delivery_task_id")
  courierId      BigInt    @map("courier_id")
  orderId        BigInt?   @map("order_id")
  reason         String    @db.VarChar(255)
  /// 上报留证照片 URL 数组（配送员上报时拍照，可多张；2026-09-19 决策⑦）
  photos         Json?
  /// 0 待处理 / 1 已处理
  status         Int       @default(0) @db.TinyInt
  handledBy      BigInt?   @map("handled_by")
  handledAt      DateTime? @map("handled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("delivery_exception")
}

// ══════════════════════════════════════════
// 4. 资金域
// ══════════════════════════════════════════

model Settlement {
  id         BigInt  @id @default(autoincrement())
  supplierId BigInt  @map("supplier_id")
  /// 如 "2026-09"
  period     String  @db.Char(7)
  /// ⚠️ 决策 3：基数 = Σ(验收数量 qty_accepted × 供货价)，不含拒收部分
  grossAmount Decimal @map("gross_amount") @db.Decimal(12, 2)
  /// ⚠️ 结算时点费率快照，改配置不追溯已生成结算单
  serviceFeeRate Decimal @map("service_fee_rate") @db.Decimal(5, 4)
  serviceFee   Decimal @map("service_fee") @db.Decimal(12, 2)
  netAmount    Decimal @map("net_amount") @db.Decimal(12, 2)
  /// 待对账/已确认/已付款
  status     Int     @default(0) @db.TinyInt
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, period])
  @@map("settlement")
}

model PurchaseBill {
  id          BigInt  @id @default(autoincrement())
  purchaserId BigInt  @map("purchaser_id")
  period      String  @db.Char(7)
  /// ⚠️ 同样以 qty_accepted 为基数（拒收不收费）
  grossAmount Decimal @map("gross_amount") @db.Decimal(12, 2)
  paidAmount  Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status      Int     @default(0) @db.TinyInt
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([purchaserId, period])
  @@map("purchase_bill")
}

/// 决策 3 新增：拒收差额自动生成售后工单
model AftersaleOrder {
  id           BigInt   @id @default(autoincrement())
  orderId      BigInt   @map("order_id")
  orderItemId  BigInt   @map("order_item_id")
  /// 1 少货 / 2 品质问题 / 3 错货 / 4 其他
  type         Int      @db.TinyInt
  reason       String?  @db.VarChar(255)
  /// 差异数量：**客户在申请页填报的「涉及数量」**（卡AE 2026-09-30 起；上限 = 该明细 qty_received，为空时用 qty_accepted）
  /// ⚠️ 历史口径 = qty_accepted − qty_received（「拒收自动建单」时代）；该自动建单已取消，新行一律为客户填报数
  qtyDiff      Decimal  @map("qty_diff") @db.Decimal(10, 2)
  /// 差异金额：**仅供参考的记录**，= qtyDiff × order_item.sale_price（成交价快照）
  /// ⚠️ 卡AE（2026-09-30）改注释对齐实现：**并没有从结算 / 账单里剔除任何钱**。
  ///    结算按 `qtyAccepted × supplyPrice` 算、压根不看售后；客户账单页是占位实现。
  ///    售后全程**不动钱**（不调微信退款、不改 Settlement、不改账单、不新增扣款/抵扣）。
  ///    ⇒ 别照旧注释去接「扣款」逻辑 —— 要接扣款必须单开卡，并同步改这里的注释。
  amountDiff   Decimal  @map("amount_diff") @db.Decimal(12, 2)
  /// 待处理/处理中/已解决/已关闭
  status       Int      @default(0) @db.TinyInt
  handledBy    BigInt?  @map("handled_by")
  handledAt    DateTime? @map("handled_at")
  /// 运营处理：补偿金额（同意补偿时记录，2026-09-10 补）
  compensateAmount Decimal? @map("compensate_amount") @db.Decimal(12, 2)
  /// 运营处理：补偿方式 1 退款 / 2 补货 / 3 下次账单抵扣
  compensateMethod Int?   @map("compensate_method") @db.TinyInt
  /// 运营处理：处理备注/驳回原因
  handleRemark String?  @map("handle_remark") @db.VarChar(255)
  /// 申请照片 URL 数组（采购方售后拍照留证，可多张；2026-09-19 决策⑦）
  attachments  Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("aftersale_order")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  operatorId BigInt   @map("operator_id")
  action     String   @db.VarChar(64)
  entity     String   @db.VarChar(64)
  entityId   BigInt   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([operatorId])
  @@map("audit_log")
}

/// 平台服务费配置（全局默认 + 可选分类覆盖）
///
/// ⚠️ 库层另有一条本 schema **故意不声明**的唯一约束（2026-09-19 卡J）：
///    生成列 global_key = COALESCE(category_id, 0) STORED + UNIQUE KEY uk_service_fee_config_global_key
///    见迁移 20260919173000_add_service_fee_unique_global。
///    原因：category_id 可空，而 MySQL 唯一索引**不约束 NULL**（多行 NULL 视为互不相同），
///    所以 @@unique([categoryId]) 挡不住「两条全局费率」这个真正的问题；
///    加生成列把「全局」归一成 0 才能兜住（category.id 自增从 1 起，0 不是合法分类）。
///    **不要声明 global_key 字段**：Prisma 会尝试写入生成列，MySQL 报 3105。
///    **不要删这条约束**：删了并发双写就又不设防（写入路径见 admin-finance.service.ts）。
model ServiceFeeConfig {
  id         BigInt    @id @default(autoincrement())
  /// null = 全局默认；非空 = 某分类覆盖
  categoryId BigInt?   @map("category_id")
  /// 费率（0.05 = 5%）
  rate       Decimal   @db.Decimal(5, 4)
  updatedBy  BigInt?   @map("updated_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("service_fee_config")
}

/// 加价比例配置（卡BI 2026-10-02）：一张表存三档，生效优先级 单品 > 供应商 > 分类 > 全局默认 > 0.30
/// ⚠️ 库层有生成列唯一键（migration 20261002090000_add_markup_config）：
///    ref_id 可空，而 MySQL 唯一索引**不约束 NULL**，Prisma 的 @@unique([scope, refId]) 挡不住
///    「重复的全局行」——同 service_fee_config 的先例，加生成列 ref_key = COALESCE(ref_id, 0)
///    再对 (scope, ref_key) 加唯一键。**不要声明 ref_key 字段**（Prisma 写生成列 MySQL 报 3105），
///    **不要删这条约束**（写入路径是单条原子 INSERT ... ON DUPLICATE KEY UPDATE，见 admin-pricing.service.ts）。
model MarkupConfig {
  id        BigInt   @id @default(autoincrement())
  /// 1 全局 / 2 分类 / 3 供应商
  scope     Int      @db.TinyInt
  /// 全局 = null；分类 = categoryId；供应商 = supplierId
  refId     BigInt?  @map("ref_id")
  /// 加价比例（0.35 = 35%），范围 0–9.99
  rate      Decimal  @db.Decimal(5, 4)
  updatedBy BigInt?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("markup_config")
}

/// 平台通用配置（key-value：运费规则等）
model PlatformConfig {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

/// 支付流水（微信支付抽象层：每笔支付独立记录，对账/退款/接真实通道都靠它）
model PaymentRecord {
  id        BigInt    @id @default(autoincrement())
  orderId   BigInt    @map("order_id")
  /// 不可枚举随机支付单号（对外暴露、回调凭据）
  payNo     String    @unique @map("pay_no") @db.VarChar(40)
  /// 支付通道：mock | wechat（预留）
  channel   String    @default("mock") @db.VarChar(20)
  /// 支付金额（口径：下单时刻应付 = amountOrdered + deliveryFee）
  amount    Decimal   @db.Decimal(12, 2)
  /// 0 待支付 / 1 成功 / 2 关闭
  status    Int       @default(0) @db.TinyInt
  /// 回调原文全量留痕（数组，含被拒回调）
  callbackPayload Json?    @map("callback_payload")
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_record")
}

/// 小程序发货信息管理 · 录入台账（卡S1 2026-09-29）
/// 为什么要单独一张表：微信侧「一笔支付单只有一次重新发货机会」（改发货模式也算），
/// 所以「录没录过 / 失败几次 / 还能不能重试 / 报什么错」必须落库 —— 靠日志或审计反推会把
/// 已经用掉机会的单反复重试。口径：本表只记「录入发货信息这件事」，不改 order 的任何语义。
/// ⚠️ 只对「已走微信支付（payment_record.channel='wechat' && status=1）」的订单建行。
model OrderShipping {
  id            BigInt    @id @default(autoincrement())
  orderId       BigInt    @unique @map("order_id")
  /// 微信侧商户单号（= payment_record.pay_no），记录当时用的是哪笔支付单
  payNo         String?   @map("pay_no") @db.VarChar(40)
  /// 物流模式：1 快递 / 2 同城配送（本项目默认）/ 3 虚拟 / 4 用户自提
  logisticsType Int       @default(2) @map("logistics_type") @db.TinyInt
  /// 发货模式：1 统一发货 / 2 分拆发货（本项目只用 1）
  deliveryMode  Int       @default(1) @map("delivery_mode") @db.TinyInt
  /// 0 待录入 / 1 已录入 / 2 失败可重试 / 3 终态失败（不再重试）
  status        Int       @default(0) @db.TinyInt
  attempts      Int       @default(0) @db.TinyInt
  /// 最近一次失败原因（微信 errcode + errmsg）
  lastError     String?   @map("last_error") @db.VarChar(255)
  /// 录入时用的商品汇总（微信必填字段 item_desc，留档便于核对）
  itemDesc      String?   @map("item_desc") @db.VarChar(255)
  uploadedAt    DateTime? @map("uploaded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("order_shipping")
}

// ══════════════════════════════════════════
// 4. 采购需求（客户要了、我们**还没有**的货）
// ══════════════════════════════════════════
//
// ⚠️ 口径边界（务必保持）——这条线**不是**「下单后供应商缺货」那条线。
//   · 本域 = 客户还没下单、我们商品库里压根没有这个菜（或该菜已下架）
//   · `order_item.qty_accepted` 那套 = 已经下单了、到货不够
//   两者是**完全独立**的两条线：不共用表、不共用页面、不互相回写。
//   把两者混在一起会让「谁欠谁多少」彻底算不清，所以这里连字段都不复用。
//
// 数据来源四种（口径 1）：① AI 对话里对不上的菜名（主，自动）② 已有商品但已下架
//   ③ 后台手动新增（电话/微信来的需求）④ 客户侧搜索无结果（**二期，不做**）
//
// ⚠️ 只读语义护栏（口径 2）：`POST /api/v1/ai/parse` **永远不写库**（只 findMany 商品）。
//   上报走前端单独调 `POST /buyer/demand/report`。为什么必须这样：所有生产只读探针
//   （巡检脚本、冒烟、Hermes 复核）都依赖「打 /ai/parse 不会产生任何写」这条前提，
//   一旦在里面插一条写库，只读探针就会开始偷偷改生产数据。**不要动这条。**

/// 采购需求·汇总（按归一化菜名聚合，后台「几人在要 / 共几次」看这张）
model PurchaseDemand {
  id BigInt @id @default(autoincrement())
  /// 归一化键（唯一）。**唯一实现只有一处**：demand/demand.util.ts 的 normalizeDemandKey()
  /// 规则：去首尾空格 → 全角转半角 → 去所有空格 → 去首尾量词/单位 → 英文小写。
  /// ⚠️ 近似词**不自动合并**（自动合并容易把两样菜并成一条）→ 后台给「合并到…」手动按钮。
  demandKey String @unique @map("demand_key") @db.VarChar(64)
  /// 显示名（首次上报时的原话，后台可改；改名**不回写** demandKey）
  name String @db.VarChar(64)
  /// 0 待采购 / 1 已下单采购中 / 2 已到货 / 3 已放弃
  status Int @default(0) @db.TinyInt
  /// 总次数（= 该需求下明细行数，每次上报重算）
  demandCount Int @default(0) @map("demand_count")
  /// 去重人数（= 该需求下去重 purchaser 数，每次上报重算）
  purchaserCount Int @default(0) @map("purchaser_count")
  firstAt DateTime @default(now()) @map("first_at")
  lastAt DateTime @default(now()) @map("last_at")
  /// 命中的**已下架**商品 id（口径 1②；未收录为 NULL）。纯标量，不声明 relation，
  /// 与 order_item.supplier_id 同为「跨聚合按约定引用」的写法。
  productId BigInt? @map("product_id")
  /// 运营备注（采购渠道 / 报价 / 为什么放弃…）
  note String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PurchaseDemandItem[]
  notifyLogs DemandNotifyLog[]

  @@index([status, lastAt])
  @@map("purchase_demand")
}

/// 采购需求·明细（谁 / 何时 / 要多少 / 原话片段）
model PurchaseDemandItem {
  id BigInt @id @default(autoincrement())
  demandId BigInt @map("demand_id")
  /// 采购方档案 id（purchaser.id）。纯标量引用，同 order_item.supplier_id 的写法
  purchaserId BigInt @map("purchaser_id")
  /// 上报账号 user_id（提报人；purchaser.user_id 唯一，二者 1:1）——发通知要它换 openid
  userId BigInt @map("user_id")
  /// ⚠️ **只存被识别成菜名的那一段**，绝不存整句对话。
  /// 为什么要卡这个：客户原话里常带电话 / 地址 / 人名（「朝阳路3号老王要两斤荷兰豆 138…」），
  /// 整句进清单=把客户隐私塞进运营导出 CSV 里。这里只留菜名片段（≤32 字）。
  rawText String @map("raw_text") @db.VarChar(64)
  qtyText String? @map("qty_text") @db.VarChar(32)
  unit String? @db.VarChar(10)
  qty Decimal? @db.Decimal(10, 2)
  /// 0 未收录 / 1 已有商品·已下架（口径 1②）
  kind Int @default(0) @db.TinyInt
  /// 1 AI 对话（自动）/ 2 后台手填（电话、微信来的需求）
  source Int @default(1) @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")

  demand PurchaseDemand @relation(fields: [demandId], references: [id])

  @@index([demandId])
  @@index([purchaserId])
  @@map("purchase_demand_item")
}

/// 到货通知·发送记录（逐人一行，只记真实发送结果）
/// ⚠️ 口径 5：发不出去的人**不群发、不假装发过**——他们没有 result='ok' 的行，
///    进小程序「我的 → 我的需求」列表 + 后台标「待其主动来访」。
model DemandNotifyLog {
  id BigInt @id @default(autoincrement())
  demandId BigInt @map("demand_id")
  purchaserId BigInt @map("purchaser_id")
  /// 1 订阅消息 / 2 客服消息 / 3 仅站内列表（= 没发出去，只登记原因）
  channel Int @db.TinyInt
  templateId String? @map("template_id") @db.VarChar(64)
  /// ok / fail
  result String @db.VarChar(8)
  /// 微信返回的 errcode（45015 = 客服消息已超 48 小时窗口）
  errCode Int? @map("err_code")
  errMsg String? @map("err_msg") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  demand PurchaseDemand @relation(fields: [demandId], references: [id])

  @@index([demandId])
  @@index([purchaserId])
  @@map("demand_notify_log")
}

/// 到货通知·订阅授权额度（每人每模板一行）
///
/// ⚠️ 这张表是「口径 4 + 验收⑦」的**必要落地**：`wx.requestSubscribeMessage` 只在**客户端**
///   发生，服务端不知道用户点了同意还是拒绝，只能靠 `POST /buyer/demand/subscribe`
///   把结果报上来。而「能不能发订阅消息」= 该用户该模板**还剩几次额度**（微信口径：
///   用户每同意一次，授予**一次**发送机会，发一次扣一次），所以必须逐人留一行额度。
///   没有这张表就没法实现「预览里分『可发 / 发不了』两类名单」。
model DemandSubscribeQuota {
  id BigInt @id @default(autoincrement())
  purchaserId BigInt @map("purchaser_id")
  templateId String @map("template_id") @db.VarChar(64)
  /// 剩余可发次数（用户每同意一次 +1，成功发出一条 -1；不会小于 0）
  quota Int @default(0)
  /// 最近一次授权时刻（用户在授权弹窗点「允许」的时刻，服务端侧记录 = 上报时刻）
  acceptedAt DateTime? @map("accepted_at")
  /// 最近一次成功发送时刻
  notifiedAt DateTime? @map("notified_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([purchaserId, templateId])
  @@map("demand_subscribe_quota")
}
